# Compose image tags
ATHENA_IMAGE=athena:local
ATHENA_WEB_IMAGE=athena-web:local

# Published ports
ATHENA_HTTP_PORT=8090
ATHENA_WEB_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

# Compose profile
# Set COMPOSE_PROFILES=control-plane when athena-web is needed.
COMPOSE_PROFILES=

# PostgreSQL container bootstrap
POSTGRES_DB=secure_digital
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Athena runtime config
HTTP_PORT=8080
SESSION_STORE_DRIVER=postgres
MODEL_STORE_DRIVER=postgres
SECURITY_ENCRYPTION_KEY=replace-with-at-least-32-byte-secret
APP_AUTH_REQUIRED=true
APP_AUTH_IDENTITIES_JSON=[{"app_id":"fund-assistant","token":"replace-with-a-distinct-app-secret","scopes":[{"workspace_id":"fund-production","app_instance_ids":["fund-web"]}]}]
CONTROL_PLANE_AUTH_TOKEN=replace-with-a-distinct-admin-secret
CONTROL_PLANE_ALLOWED_ORIGINS=http://localhost:5173
CONTROL_PLANE_STORE_PATH=config/controlplane/overrides.json
# Comma-separated app callback origins, for example http://fund-api:8081.
REMOTE_TOOL_ALLOWED_ORIGINS=
REMOTE_TOOL_MAX_RESPONSE_BYTES=1048576
SHARED_ROOT_DIR=/srv/shared
OBSERVABILITY_LOG_LEVEL=info

# Durable asynchronous Agent Runs
ASYNC_JOBS_ENABLED=true
REDIS_URL=redis://redis:6379/0
ASYNC_JOB_STREAM=athena:{async-jobs}:deliveries
ASYNC_JOB_GROUP=athena-workers
ASYNC_JOB_CONSUMER=athena-worker
ASYNC_JOB_DISPATCHER_POLL_MS=250
ASYNC_JOB_OUTBOX_LEASE_MS=10000
ASYNC_JOB_VISIBILITY_TIMEOUT_MS=30000
ASYNC_JOB_CANCEL_POLL_MS=250
ASYNC_JOB_RETRY_BASE_MS=1000
ASYNC_JOB_RETRY_MAX_MS=30000
ASYNC_JOB_MAX_ATTEMPTS=3
ASYNC_JOB_BATCH_SIZE=100

# Shared PostgreSQL connection
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=secure_digital
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_CONFIG=sslmode=disable search_path=athena client_encoding=UTF8
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=70
DB_CONN_MAX_LIFETIME_SECONDS=300
DB_LOG_MODE=false
DB_LOG_ZAP=info

# Optional platform context client
# PLATFORM_CONTEXT_BASE_URL=https://platform.example.com
# PLATFORM_CONTEXT_DETAIL_TIMEOUT_SECONDS=5
# PLATFORM_CONTEXT_AUTH_HEADER=Authorization
# PLATFORM_CONTEXT_AUTH_TOKEN=
# PLATFORM_CONTEXT_FORWARD_AUTHORIZATION=true
