# Local Compose published ports
ATHENA_HTTP_PORT=8080
ATHENA_WEB_PORT=5173
ATHENA_POSTGRES_PORT=5432
ATHENA_REDIS_PORT=6379

# PostgreSQL bootstrap and Athena connection
POSTGRES_DB=athena
POSTGRES_USER=athena
POSTGRES_PASSWORD=athena-local-change-me
SECURITY_ENCRYPTION_KEY=replace-before-nonlocal-use

# Athena runtime observability and remote callback governance
OBSERVABILITY_LOG_LEVEL=info
REMOTE_TOOL_ALLOWED_ORIGINS=http://fund-api:8081

# Optional web control-plane profile
# COMPOSE_PROFILES=control-plane
COMPOSE_PROFILES=

# Business app integration contract
# A fund assistant service on the same Compose network uses this value for ATHENA_BASE_URL.
ATHENA_INTERNAL_BASE_URL=http://athena-api:8080
# A host-run fund assistant uses this value for ATHENA_BASE_URL.
ATHENA_EXTERNAL_BASE_URL=http://127.0.0.1:8080
# Set only when Athena auth middleware is enabled; fund assistant forwards this as ATHENA_AUTH_TOKEN.
ATHENA_AUTH_TOKEN=
